EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# RevenueCat — development build or store build required for IAP (not Expo Go)
# Test Store key (one key for iOS + Android while testing):
EXPO_PUBLIC_REVENUECAT_API_KEY=
# Or platform-specific production keys:
# EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_...
# EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_...

# Set to true to unlock Pro locally without the store
# EXPO_PUBLIC_SUBSCRIPTION_DEV_PRO=true
